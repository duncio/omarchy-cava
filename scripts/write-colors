#!/usr/bin/env bash

# Render cava's theme file from the current Omarchy theme.
#
# Cava reads its theme from $XDG_CONFIG_HOME/cava/themes/<name>, and the visualizer
# runs with XDG_CONFIG_HOME pointed at the plugin's state directory (see
# scripts/backdrop), so the generated file lands there and the user's own
# ~/.config/cava is never touched.
#
# Colors are resolved by omarchy-theme-color, the same resolver Omarchy's theme
# templates use, so aliases and derived shades match the rest of the desktop.
#
# Exit status is the point of this script: 0 means the file changed and the
# visualizer has to be restarted to pick it up, 1 means it is already current.

set -euo pipefail

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-cava"
theme_colors="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current/theme/colors.toml"
target="$state_dir/xdg/cava/themes/omarchy"

if [[ ! -f $theme_colors ]]; then
  echo "write-colors: no current theme at $theme_colors" >&2
  exit 1
fi

# The terminal palette, bottom to top: cava draws a vertical gradient over the
# bars, so the first color is the one at the bottom. Themes are free not to define
# a color, so every lookup falls back to the accent and then to the foreground.
color() {
  local value
  value=$(omarchy-theme-color --file "$theme_colors" "$1" "$2" 2>/dev/null || true)
  value=${value:-$3}
  printf '%s' "$value"
}

accent=$(color accent "" "#b59790")
foreground=$(color foreground "" "#fafcfb")

blue=$(color blue "$accent" "$foreground")
cyan=$(color cyan "$blue" "$foreground")
green=$(color green "$cyan" "$foreground")
yellow=$(color yellow "$green" "$foreground")
orange=$(color orange "$yellow" "$foreground")
red=$(color red "$orange" "$foreground")

next=$(mktemp)
trap 'rm -f "$next"' EXIT

cat >"$next" <<EOF
# Generated by omarchy-cava from the current Omarchy theme. Do not edit: it is
# rewritten whenever the theme changes.
[color]
gradient = 1
gradient_color_1 = '$blue'
gradient_color_2 = '$cyan'
gradient_color_3 = '$green'
gradient_color_4 = '$yellow'
gradient_color_5 = '$orange'
gradient_color_6 = '$red'
EOF

if [[ -f $target ]] && cmp -s "$next" "$target"; then
  exit 1
fi

mkdir -p "$(dirname "$target")"
install -m 644 "$next" "$target"
exit 0